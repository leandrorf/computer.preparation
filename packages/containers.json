{
  "category": "Containers",
  "packages": [
    {
      "id": "Microsoft.WSL",
      "name": "Windows Subsystem for Linux (WSL 2)",
      "windowsFeatures": ["Microsoft-Windows-Subsystem-Linux", "VirtualMachinePlatform"],
      "upgrade": true,
      "reboot": true
    },
    { "id": "Canonical.Ubuntu.2404", "name": "Ubuntu 24.04 LTS (WSL)" },
    {
      "id": "Docker.DockerDesktop",
      "name": "Docker Desktop",
      "args": ["--override", "install --quiet --accept-license --backend=wsl-2"],
      "reboot": true
    }
  ]
}
